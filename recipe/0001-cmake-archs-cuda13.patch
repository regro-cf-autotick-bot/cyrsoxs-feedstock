 set(CMAKE_CUDA_FLAGS "${CMAKE_CUDA_FLAGS} -Xcompiler -fopenmp -DNDEBUG --use_fast_math")
 
+#
+# Select supported GPU architectures sanely.
+# - If the CI/migrator provides CUDAARCHS, honor it.
+# - CUDA 13: Turing+ only (no Maxwell/Pascal).
+# - CUDA 12: drop Maxwell; keep Pascal/Turing/Ampere/Hopper.
+# - Older toolkits: keep the legacy list.
+#
+if(DEFINED ENV{CUDAARCHS})
+  set(CMAKE_CUDA_ARCHITECTURES "$ENV{CUDAARCHS}")
+elseif(CUDAToolkit_VERSION VERSION_GREATER_EQUAL 13.0)
+  set(CMAKE_CUDA_ARCHITECTURES 70 75 80 86 89 90)
+elseif(CUDAToolkit_VERSION VERSION_GREATER_EQUAL 12.0)
+  set(CMAKE_CUDA_ARCHITECTURES 60 61 70 75 80 86 89 90)
+else()
+  set(CMAKE_CUDA_ARCHITECTURES 52 53 60 61 62 70 72)
+endif()
+
+
